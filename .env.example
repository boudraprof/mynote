# Database
DATABASE_URL=postgres://notes:pass@localhost:5432/notes

# Better Auth (generate a secret with: openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-chars
BETTER_AUTH_BASE_URL=http://localhost:3000
BETTER_AUTH_BASE_PATH=v1/api

# Client-side Better Auth (must match server values)
NEXT_PUBLIC_BETTER_AUTH_BASE_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_BASE_PATH=v1/api

# OAuth providers (optional — leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Client-side Google OAuth (set to your Google client ID after creating OAuth credentials)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Client-side flag to show the "Sign in with Google" button (set to your client id)

# App URLs
NEXT_PUBLIC_API_URL=http://localhost:3000
APP_URL=http://localhost:3000

# SMTP for sending verification & password-reset emails (optional —
# if blank, emails are logged to the server console in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=My Notes

# Comma-separated origins trusted for auth (mobile app, preview deployments)
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8081

# Cookie/session hardening (production). Set BETTER_AUTH_SECURE_COOKIES=true
# to force HTTPS-only cookies (requires serving over HTTPS). Optionally set
# BETTER_AUTH_COOKIE_SAMESITE=strict for tighter CSRF protection (use 'lax'
# if you rely on cross-site OAuth redirects).
BETTER_AUTH_SECURE_COOKIES=false
BETTER_AUTH_COOKIE_SAMESITE=lax

# ImageKit credentials for image uploads,
# leave blank to use local storage
# (optional — get your credentials from https://imagekit.io)

IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Sentry (error tracking — get your DSN from https://sentry.io)
NEXT_PUBLIC_SENTRY_DSN=

# Comma-separated origins allowed for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081