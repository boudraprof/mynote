{
  "cli": {
    "version": ">= 20.5.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.1.130:3000",
        "EXPO_PUBLIC_API_BASE_PATH": "api/v1"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://mynote-demo.vercel.app",
        "EXPO_PUBLIC_API_BASE_PATH": "api/v1"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://mynote-demo.vercel.app",
        "EXPO_PUBLIC_API_BASE_PATH": "api/v1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
