{
  "name": "My notes",
  "version": "10.0.1",
  "private": true,
  "scripts": {
    "build": "next build",
    "start": "next start",
    "dev": "no_proxy=localhost,127.0.0.1,::1 next dev",
    "mobile:dev": "cd mobile-app/ && npm start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "db:migrate": "npx drizzle-kit migrate",
    "db:generate": "npx drizzle-kit generate",
    "db:studio": "npx drizzle-kit studio",
    "db:push": "npx drizzle-kit push",
    "db:drop": "npx drizzle-kit drop",
    "db:seed": "tsx scripts/seed-note-status.ts",
    "better:migrate": "npx @better-auth/cli migrate",
    "better:generate": "npx @better-auth/cli generate",
    "lint": "eslint",
    "fix": "eslint --fix",
    "format": "prettier",
    "check": "prettier --write . && eslint --fix"
  },
  "dependencies": {
    "@better-auth/expo": "^1.6.23",
    "@cloudinary/react": "^1.14.4",
    "@cloudinary/url-gen": "^1.22.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/react": "^10.68.0",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.18.1",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.12",
    "drizzle-orm": "^0.45.1",
    "geist": "^1.7.2",
    "jotai": "2.10.0",
    "lucide-react": "^1.7.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "pg": "^8.17.1",
    "radix-ui": "^1.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-toastify": "^11.0.5",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.4.0",
    "use-debounce": "^10.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
